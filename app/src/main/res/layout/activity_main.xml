<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:background="#1E293B">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xen Customizer"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <ScrollView
            android:id="@+id/tabWallpaperView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivWallpaperPreview"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:scaleType="centerCrop"
                    android:background="#1E293B" />

                <Button
                    android:id="@+id/btnSelectPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Select Photo from Gallery"
                    android:textAllCaps="false"
                    android:background="@drawable/glass_button" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Blur Amount"
                    android:textColor="#FFFFFFFF" />

                <SeekBar
                    android:id="@+id/sbBlur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="25"
                    android:progress="10" />

                <Button
                    android:id="@+id/btnSetWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Apply as Home &amp; Lock Wallpaper"
                    android:textAllCaps="false"
                    android:background="@drawable/glass_button" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tabWidgetsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Glass Widgets"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnAddClockWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Add Glass Clock Widget"
                    android:textAllCaps="false"
                    android:background="@drawable/glass_button"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnAddStatsWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Add Battery &amp; Storage Stats Widget"
                    android:textAllCaps="false"
                    android:background="@drawable/glass_button"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnAddSearchWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Add Glass Search Bar"
                    android:textAllCaps="false"
                    android:background="@drawable/glass_button" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tabGlassifyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Glassify - Glass Docks &amp; Containers"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Place frosted glass background panels behind your home screen apps."
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnAddDockWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Add Frosted Glass Dock Container"
                    android:textAllCaps="false"
                    android:background="@drawable/glass_button" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/tabIconsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme App Icons (No Launcher Needed)"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E293B"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNavWallpaper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Wallpaper"
            android:textSize="10sp"
            android:textColor="#FF38BDF8"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnNavWidgets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Widgets"
            android:textSize="10sp"
            android:textColor="#FFFFFFFF"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnNavGlassify"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Glassify"
            android:textSize="10sp"
            android:textColor="#FFFFFFFF"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnNavIcons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Icons"
            android:textSize="10sp"
            android:textColor="#FFFFFFFF"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>
</LinearLayout>
