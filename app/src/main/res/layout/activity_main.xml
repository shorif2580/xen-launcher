<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF08090C"
    android:orientation="vertical">

    <!-- হেডার -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF111319"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="XEN CUSTOMIZER"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="PRO UNLOCKED"
            android:textColor="#FF38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- মূল কনটেন্ট এরিয়া -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ১. উইজেট ট্যাব (Glassify Grid) -->
        <LinearLayout
            android:id="@+id/viewTabWidgets"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWidgetsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- ২. ওয়ালপেপার স্টুডিও ট্যাব -->
        <ScrollView
            android:id="@+id/viewTabWallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="#FF141722">

                    <ImageView
                        android:id="@+id/ivStudioPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#FF1C2030" />

                    <!-- লাইভ ক্লক ওভারলে প্রিভিউ -->
                    <LinearLayout
                        android:id="@+id/layoutClockOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginTop="30dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextClock
                            android:id="@+id/tcStudioClock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="hh:mm"
                            android:format24Hour="kk:mm"
                            android:textColor="#FFFFFFFF"
                            android:textSize="50sp"
                            android:textStyle="bold" />

                        <TextClock
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="EEEE, d MMMM"
                            android:format24Hour="EEEE, d MMMM"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <Button
                    android:id="@+id/btnPickImage"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_gradient"
                    android:text="Choose Photo from Gallery"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Blur Amount"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sbBlur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="25"
                    android:progress="8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Darken / Tint Amount"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sbDim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="30" />

                <CheckBox
                    android:id="@+id/cbClockOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:checked="true"
                    android:text="Burn Glass Clock into Wallpaper"
                    android:textColor="#FF38BDF8"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnApplyWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/btn_gradient"
                    android:text="Set as Home &amp; Lock Wallpaper"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- ৩. আইকন প্যাক ট্যাব -->
        <LinearLayout
            android:id="@+id/viewTabIcons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Frosted Glass App Icons (No Launcher Needed)"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIconsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>

    <!-- নিচের ৩টি প্রধান নেভিগেশন বাটন -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FF111319"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNavWidgets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Widgets"
            android:textColor="#FF38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnNavWallpaper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Wallpaper"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnNavIcons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Glass Icons"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>
</LinearLayout>
